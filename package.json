{
  "name": "vegas-planning-poker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "supabase": "npx --yes supabase@3.2.0",
    "db:login": "npm run supabase -- login",
    "db:link": "npm run supabase -- link",
    "db:history": "npm run supabase -- migration list --remote",
    "db:plan": "npm run supabase -- db push --remote --skip-vault --dry-run",
    "db:migrate": "npm run supabase -- db push --remote --skip-vault",
    "db:new": "npm run supabase -- migration new",
    "test": "node --test tests/*.test.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "^5.7.2"
  }
}
