# Optional hosted persistence. Without these, only the local demo is available (no admin console).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admins enroll/verify TOTP at login. Keep enabled in production.
# Even when false, accounts with an enrolled factor still require MFA.
ADMIN_REQUIRE_MFA=true
